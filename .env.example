# Required only when uploading artifacts to Yandex Disk
YANDEX_DISK_TOKEN=

# Optional Yandex Search API discovery
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Optional Yandex Wiki publisher
YANDEX_WIKI_TOKEN=
YANDEX_WIKI_CLOUD_ORG_ID=
YANDEX_WIKI_API_BASE=https://api.wiki.yandex.net

# Required when running the HTTP API
SCRAPPER_API_KEY=change-me

# Common crawler controls
UPLOAD_ENABLED=0
WEB_CRAWL_DELAY_SEC=5.0
CRAWL_MAX_PAGES_PER_SOURCE=120
ELECTRICAL_ONLY=1
ELECTRICAL_SCORE_THRESHOLD=2
SEARCH_DISCOVERY_ENABLED=1
# Provider selection (safe, credential-free defaults)
DOC_HARVESTER_STORAGE=local
DOC_HARVESTER_PROFILE=electrical
DOC_HARVESTER_LOCAL_STORAGE_ROOT=storage
DOC_HARVESTER_PUBLISHER=local
DOC_HARVESTER_PUBLISH_ROOT=published

# Optional S3 or S3-compatible storage
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
