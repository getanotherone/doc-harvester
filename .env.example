# doc-harvester standalone configuration
#
# Copy to .env only when you want file-based local configuration. The public CLI reads
# exported process variables and does not automatically load this file. Never commit .env.
# Keep secrets blank here; set real values only in your ignored .env or secret manager.

# -----------------------------------------------------------------------------
# Safe credential-free defaults
# -----------------------------------------------------------------------------
DOC_HARVESTER_STORAGE=local
DOC_HARVESTER_LOCAL_STORAGE_ROOT=storage
DOC_HARVESTER_PUBLISHER=local
DOC_HARVESTER_PUBLISH_ROOT=published
UPLOAD_ENABLED=0

# Only the legacy electrical profile is bundled today. Omit this variable when using the
# universal `source` commands, or point it to your own validated profile for crawl/files.
# DOC_HARVESTER_PROFILE=electrical

# -----------------------------------------------------------------------------
# Credential-free source discovery and fetching
# -----------------------------------------------------------------------------
DOC_HARVESTER_DISCOVERY_LIMIT=100
DOC_HARVESTER_MAX_SITEMAPS=20
DOC_HARVESTER_MAX_SITEMAP_BYTES=10485760
DOC_HARVESTER_FETCH_ROOT=.
DOC_HARVESTER_MAX_FETCH_BYTES=52428800
DOC_HARVESTER_HTTP_TIMEOUT=30
DOC_HARVESTER_MAX_MANIFEST_BYTES=5242880
DOC_HARVESTER_MAX_CHUNK_TOKENS=800

# -----------------------------------------------------------------------------
# Optional standalone HTTP API
# -----------------------------------------------------------------------------
# Required only for `doc-harvester api`. Generate a unique random value; do not use a
# documented placeholder in a running service.
SCRAPPER_API_KEY=

# -----------------------------------------------------------------------------
# Optional S3 or S3-compatible storage
# -----------------------------------------------------------------------------
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Optional documentation publishers
# -----------------------------------------------------------------------------

# Notion
NOTION_TOKEN=
NOTION_API_BASE=https://api.notion.com/v1
NOTION_API_VERSION=2026-03-11

# Confluence Cloud
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=
CONFLUENCE_PARENT_PAGE_ID=

# Yandex Wiki (legacy optional adapter)
YANDEX_WIKI_TOKEN=
YANDEX_WIKI_CLOUD_ORG_ID=
YANDEX_WIKI_API_BASE=https://api.wiki.yandex.net

# -----------------------------------------------------------------------------
# Optional legacy Yandex discovery and storage adapters
# -----------------------------------------------------------------------------
YANDEX_DISK_TOKEN=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# -----------------------------------------------------------------------------
# Legacy crawl/files compatibility controls
# -----------------------------------------------------------------------------
# These affect the original scraper commands, not `source discover` or `source fetch`.
# Universal defaults disable provider search and electrical-only filtering.
WEB_CRAWL_DELAY_SEC=5.0
CRAWL_MAX_PAGES_PER_SOURCE=120
CRAWL_CHILD_PAGES=1
BFS_ENABLED=1
CONSECUTIVE_404_THRESHOLD=20
SITEMAP_ENABLED=1
SEARCH_DISCOVERY_ENABLED=0
SEARCH_MAX_QUERIES_PER_SOURCE=50
ELECTRICAL_ONLY=0
ELECTRICAL_SCORE_THRESHOLD=2
FOLLOW_CHILD_SCORE_THRESHOLD=0
WEB_MIN_PRODUCT_SCORE=2
WEB_MIN_CONTENT_BLOCKS=3
QUALITY_GATE_BLOCK_WARN=1
QUARANTINE_SUBDIR=_quarantine
UPLOAD_WORKERS=4
MAX_ZIP_SIZE_MB=300

# -----------------------------------------------------------------------------
# Optional browser rendering controls for legacy `--spa` crawling
# -----------------------------------------------------------------------------
BROWSER_TIMEOUT_MS=30000
BROWSER_RECYCLE_INTERVAL=200
BROWSER_CHANNEL=chrome
SPA_RENDER_WAIT_MS=3000
# BROWSER_STATE_PATH=data/browser_state.json

# -----------------------------------------------------------------------------
# Optional chunk and quality thresholds
# -----------------------------------------------------------------------------
CHUNK_JSON_INDENT=0
QUALITY_MIN_TOKENS=40
QUALITY_MAX_EMPTY_RATIO=0.01
QUALITY_MAX_TINY_RATIO=0.35
QUALITY_MAX_DUPLICATE_RATIO=0.25
QUALITY_MAX_NOISY_RATIO=0.30

# Optional bridge script target (`scripts/ingest_to_docproc.py`)
DOCPROC_URL=http://localhost:8001

# DocProc is independently deployable and has its own configuration template:
# services/doc_proc/.env.example
