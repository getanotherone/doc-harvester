# Database
POSTGRES_USER=doc_proc
POSTGRES_PASSWORD=doc_proc
POSTGRES_DB=doc_proc
DATABASE_URL=postgresql+asyncpg://doc_proc:doc_proc@postgres:5432/doc_proc

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=1
EMBEDDING_TIMEOUT=180

# Parsing
MAX_UPLOAD_SIZE_MB=500
MAX_PDF_OCR_SIZE_MB=50
OCR_ENGINE=tesseract
OCR_LANGUAGES=rus+eng
DOCLING_TABLE_MODE=fast
DOCLING_IMAGES_SCALE=0.75

# Worker
WORKER_MAX_CONCURRENT=1
WORKER_MAX_CHUNKS=50000
MAX_EXCEL_CELLS=2000000

# Domain (electrical engineering) — these are PipelineConfig defaults
# EXTRACT_DOMAIN_METADATA=true   # vendor, standard, doc_type, lang extraction
# SKIP_CID_GARBAGE=true           # filter PDF font-decoding artifacts
